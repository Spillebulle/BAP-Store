<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<!--
  The polkit action for brokey-helper, the one part of Brokey that runs as
  root. pkexec matches this action by the exec.path annotation, so it applies
  only to the packaged helper at /usr/lib/brokey/brokey-helper. auth_admin_keep
  for the active session is what makes a batch of installs one password:
  polkit keeps the authorisation for a few minutes.

  A development build (cargo run, target/debug/brokey-helper) has no policy of
  its own. pkexec then falls back to org.freedesktop.policykit.exec and its
  generic "run a program as another user" dialog, and asks again for every
  helper run. Nothing is installed to make development work; that is by
  design.

  Installed to /usr/share/polkit-1/actions/ by every package shape.
-->
<policyconfig>
  <vendor>Brokey</vendor>
  <vendor_url>https://github.com/Spillebulle/Brokey</vendor_url>

  <action id="io.github.spillebulle.brokey.helper">
    <description>Install, remove or update software through Brokey</description>
    <message>Authentication is required to install, remove or update software.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/brokey/brokey-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
